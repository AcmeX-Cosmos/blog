---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import ReferenceCard from '../components/ReferenceCard.astro';
import PaperToc from '../components/PaperToc.astro';
import PostList from '../components/PostList.astro';
import BlogSidebar from '../components/BlogSidebar.astro';
import { PAGE_SIZE, countByCategory, countTags, sortedPosts } from '../utils/posts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const postPaths = posts.map(post => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
  const totalPages = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
  const pagePaths = Array.from({ length: totalPages - 1 }, (_, index) => ({
    params: { slug: String(index + 2) },
    props: { page: index + 2 },
  }));
  return [...postPaths, ...pagePaths];
}

const { post, page } = Astro.props;
const isBlogPage = typeof page === 'number';
const allPosts = isBlogPage ? sortedPosts(await getCollection('blog')) : [];
const totalPages = isBlogPage ? Math.max(1, Math.ceil(allPosts.length / PAGE_SIZE)) : 1;
const pagePosts = isBlogPage
  ? allPosts.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE)
  : [];
const tagCounts = isBlogPage ? countTags(allPosts) : [];
const counts = isBlogPage ? countByCategory(allPosts) : {};

const { Content, headings } = isBlogPage ? { Content: null, headings: [] } : await post.render();
const slug = post?.id.replace(/\.md$/, '') || '';
const isPaperCollection = !isBlogPage && slug.startsWith('research-papers-');
const isDailyLife = !isBlogPage && post.data.category === 'daily';
const tocHeadings = headings.filter(heading => heading.depth === 2);
const hasToc = !isBlogPage;
---

{isBlogPage ? (
  <SiteLayout title={`All Posts - Page ${page} | AcmeX`}>
    <div id="content-header" class="animate">
      <div class="mb-6 mt-6 sm:mt-10">
        <h1 class="inline-block text-3xl font-medium tracking-tight">All Posts</h1>
      </div>
    </div>

    <div class="grid gap-y-16 sm:grid-cols-[3fr_1fr] sm:gap-x-8">
      <section aria-label="Blog posts list" class="animate" id="content">
        <PostList
          posts={pagePosts}
          totalCount={allPosts.length}
          page={{ current: page, total: totalPages, size: PAGE_SIZE, baseUrl: '/blog' }}
        />
      </section>

      <BlogSidebar counts={counts} tagCounts={tagCounts} />
    </div>
  </SiteLayout>
) : (
<SiteLayout title={post.data.title} description={post.data.description} universeOpacity={0.15}>
  <div class:list={['article-toc-layout', { 'has-toc': hasToc }]}>
  <article class:list={['max-w-none', 'article-with-toc', { 'paper-reading-article': isPaperCollection, 'daily-life-article': isDailyLife }]}>
    <header class="mb-10 pb-8 border-b border-[hsl(var(--border))]">
      <h1 class="text-3xl font-bold mb-3 leading-tight tracking-tight">
        {post.data.title}
      </h1>
      {post.data.description && (
        <p class="text-[hsl(var(--muted-foreground))] mb-4 leading-relaxed text-lg">
          {post.data.description}
        </p>
      )}
      <div class="flex items-center gap-3 flex-wrap">
        <time class="text-sm text-[hsl(var(--muted-foreground))] font-mono">
          {new Date(post.data.date).toLocaleDateString('zh-CN', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          })}
        </time>
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="flex gap-2 flex-wrap">
            {post.data.tags.map(tag => (
              <a
                href={`/blog/tag/${encodeURIComponent(tag)}`}
                class="rounded-full border border-[hsl(var(--border))] bg-[hsl(var(--muted))] px-3 py-1 text-xs font-medium text-[hsl(var(--muted-foreground))] hover:bg-[hsl(var(--foreground))] hover:text-[hsl(var(--background))] transition-colors"
              >
                {tag}
              </a>
            ))}
          </div>
        )}
      </div>
    </header>

    {hasToc && <PaperToc headings={tocHeadings} variant="mobile" title={post.data.title} />}

    <div class="article-content">
      <Content />
    </div>

    <ReferenceCard references={post.data.references} />

    <div class="mt-16 pt-8 border-t border-[hsl(var(--border))]">
      <a href="/blog" class="inline-flex items-center gap-1 text-sm text-[hsl(var(--muted-foreground))] hover:text-[hsl(var(--foreground))] transition-colors">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        回到文章列表
      </a>
    </div>
  </article>

  {hasToc && <PaperToc headings={tocHeadings} variant="desktop" title={post.data.title} />}
  </div>
</SiteLayout>
)}
