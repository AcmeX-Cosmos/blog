---
import { getCollection } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import TagFilter from '../../../components/TagFilter.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const allTagsSet = new Set(posts.flatMap(p => p.data.tags || []));
  return Array.from(allTagsSet).map(tag => ({
    params: { tag },
    props: { tag, allTags: Array.from(allTagsSet).sort() },
  }));
}

const { tag, allTags } = Astro.props;

const posts = (await getCollection('blog'))
  .filter(p => (p.data.tags || []).includes(tag))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<SiteLayout>
  <section>
    <div class="mb-6 mt-6 sm:mt-10">
      <h1 class="inline-block text-3xl font-semibold tracking-tight">
        标签: <span class="text-[hsl(var(--muted-foreground))]">{tag}</span>
      </h1>
      <p class="mt-1 text-sm text-[hsl(var(--muted-foreground))]">
        {posts.length} 篇文章
      </p>
    </div>

    <TagFilter allTags={allTags} activeTag={tag} />

    <div class="flex flex-col gap-y-2">
      {posts.map(post => (
        <PostCard
          href={`/blog/${post.id.replace(/\.md$/, '')}`}
          title={post.data.title}
          date={post.data.date}
          description={post.data.description}
          tags={post.data.tags}
        />
      ))}
    </div>
  </section>
</SiteLayout>
