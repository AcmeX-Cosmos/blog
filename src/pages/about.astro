---
import SiteLayout from '../layouts/SiteLayout.astro';

const personalityTagsLeft = [
  { text: '穷究理探机微' },
  { text: '遇挫死磕疑难' },
  { text: '志广兴至则迁' },
];

const personalityTagsRight = [
  { text: '沉心俗务罔闻' },
  { text: '重践以规自守' },
  { text: '智思敛不情泄' },
];

const pursuitWords = [
  { text: '专注', color: '#5b27ff' },
  { text: '创造', color: '#00d4ff' },
  { text: '纯粹', color: '#22c55e' },
  { text: '激极尽志', color: '#ff27e8' },
];

const skillCategories = [
  { name: 'VLA', items: ['Qwen-VL', 'Nemotron-VL', 'LLM Agent'] },
  { name: 'Robotics', items: ['ROS2', 'Isaac Sim', 'Isaac Lab', 'Franka', 'GraspNet'] },
  { name: 'Robot Learning', items: ['ACT', 'BC', 'Diffusion Policy', 'PPO'] },
  { name: 'Vision', items: ['OpenCV', 'YOLO', 'SAM', 'RGB-D', 'Point Cloud'] },
  { name: 'Deep Learning', items: ['PyTorch', 'CUDA', 'TensorRT', 'Transformer'] },
  { name: 'Simulation', items: ['Omniverse', 'USD', 'Blender', 'UE5'] },
  { name: 'Optimization', items: ['Ceres', 'EKF', 'SLAM', 'SE(3)'] },
  { name: 'Engineering', items: ['Linux', 'Docker', 'Git', 'C++', 'Python'] },
];
const skills = skillCategories.flatMap(c => c.items);
const skillsTop = skillCategories.slice(0, 4).flatMap(c => c.items);
const skillsBottom = skillCategories.slice(4).flatMap(c => c.items);

const hobbyItems = [
  { icon: '🎮', label: '爱好游戏', value: 'CS:GO' },
  { icon: '🎯', label: '爱好游戏', value: 'Valorant' },
];

const interestItems = [
  { icon: '💻', label: '数码科技', desc: '机器人、嵌入式软硬件' },
  { icon: '🎵', label: '音乐偏好', desc: '电子乐、古典、轻音乐' },
];

const tenYearStart = '2022-05-28';
const tenYearEnd = '2032-05-28';
const startDate = new Date(tenYearStart).getTime();
const endDate = new Date(tenYearEnd).getTime();
const now = Date.now();
const progress = Math.min(100, Math.max(0, Math.round(((now - startDate) / (endDate - startDate)) * 100)));
const daysLeft = Math.max(0, Math.ceil((endDate - now) / (1000 * 60 * 60 * 24)));

const awards = [
  'RMUC 2024 全国赛 国家二等奖',
  'RMUC 2023 全国赛 区域赛奖',
  'RMUL 2025 (广西站) 团体 & 哨兵',
  'RMUL 2024 (广东站) 团体 & 哨兵',
  '2023 全国大学生电子设计竞赛 省级二等奖',
  '2023-2025 赛季 RM 区域赛/兵种奖 一二等奖若干',
];

const projects = [
  {
    title: 'RoboMaster 机器人跟踪射击系统',
    role: '核心算法负责人',
    period: '2023.09 至今',
    description: '基于 ROS2 架构的自动瞄准跟踪系统，涵盖装甲板检测、PnP + Ceres BA 位姿优化、9维 EKF 多传感器融合跟踪与四阶龙格库塔弹道补偿。',
    tags: ['ROS2', 'OpenCV', 'Ceres', 'EKF', 'UE5'],
  },
  {
    title: '骰子识别与姿态估计系统',
    role: '独立完成',
    period: '2025.04—2025.06',
    description: '基于 YOLOv10 + PnP + BA + PoseNet 多模型融合的骰子 6D 姿态估计系统，训练损失 MAE 低至 0.034 rad。',
    tags: ['YOLOv10', 'PnP', 'PoseNet', 'PyQt5'],
  },
  {
    title: 'CycleGAN 艺术风格迁移与 3D 纹理渲染',
    role: '独立完成',
    period: '2025.09—2025.10',
    description: 'CycleGAN 实现风景到梵高风格迁移，自建 2700 张数据集。Blender Python 脚本自动化纹理映射与批量渲染。',
    tags: ['CycleGAN', 'PyTorch', 'Blender', 'Python'],
  },
];
---

<SiteLayout>
  <div id="web_bg_about"></div>
  <article id="about-page">
    <!-- ====== Author Box with Avatar ====== -->
    <div class="author-box">
      <div class="author-tag-left">
        {personalityTagsLeft.map((tag) => (
          <span class="author-tag">{tag.text}</span>
        ))}
      </div>
      <div class="author-img">
        <img src="/blog/avatar.jpg" alt="avatar" />
      </div>
      <div class="author-tag-right">
        {personalityTagsRight.map((tag) => (
          <span class="author-tag">{tag.text}</span>
        ))}
      </div>
    </div>

    <p class="p center logo large">AcmeX</p>
    <p class="p center small">追求极致, 探索未知</p>

    <!-- ====== Row 1: MyInfo & Pursuit ====== -->
    <div class="author-content">
      <div class="author-content-item myInfoAndSayHello">
        <div class="title1">你好，很高兴认识你 👋</div>
        <div class="title2">我叫 <span class="inline-word">陈泽欣</span></div>
        <div class="title1">是一名 <span>机器人视觉算法工程师</span>、<span>VLA 世界模型</span> 探索者</div>
      </div>
      <div class="aboutsiteTips author-content-item">
        <div class="author-content-item-tips">追求</div>
        <h2>源于<br/>热爱而去 感受
          <div class="mask">
            {pursuitWords.map((word, i) => (
              <span class:list={['first-tips' && i === 0]} data-show={i === 0 ? '' : null}>{word.text}</span>
            ))}
          </div>
        </h2>
      </div>
    </div>

    <!-- ====== Row 2: Skills & Career ====== -->
    <div class="author-content">
      <div class="author-content-item skills">
        <div class="card-content">
          <div class="author-content-item-tips">技能</div>
          <span class="author-content-item-title">开启创造力</span>
          <div class="skills-style-group">
            <div id="skills-tags-group-all">
              <div class="tags-group-wrapper">
                {skillsTop.map((skill, i) => (
                  <div class="tags-group-icon-pair">
                    <div class="tags-group-icon" style="background: var(--about-tag-bg);">
                      <span class="skill-icon-text">{skill}</span>
                    </div>
                    <div class="tags-group-icon" style="background: var(--about-tag-bg);">
                      <span class="skill-icon-text">{skillsBottom[i % skillsBottom.length]}</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
            <div class="skills-list">
              {skillCategories.map((cat) => (
                <div class="skill-category">
                  <div class="skill-category-header">{cat.name}</div>
                  <div class="skill-category-items">
                    {cat.items.map((skill) => (
                      <div class="skill-info">
                        <span class="skill-icon-text-small">{skill}</span>
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
      <div class="author-content-item careers">
        <div class="card-content">
          <div class="author-content-item-tips">生涯</div>
          <span class="author-content-item-title">无限进步</span>
          <div class="careers-group">
            <div class="career-item">
              <div class="circle" style="background:#357ef5"></div>
              <div class="name">深圳职业技术大学，人工智能技术应用</div>
            </div>
          </div>
          <img class="author-content-img" alt="生涯" src="/blog/images/career.png" />
        </div>
      </div>
    </div>

    <!-- ====== Aim Game ====== -->
    <div class="hello-about aim-game" id="aim-game">
      <canvas id="aim-canvas"></canvas>
      <div class="aim-ui aim-ui-top">
        <div class="aim-stats">
          <span class="aim-hits">击中: <strong id="aim-hits">0</strong>/12</span>
          <span class="aim-kpm">KPM: <strong id="aim-kpm">0</strong></span>
        </div>
        <div class="aim-controls">
          <button id="aim-auto-toggle" class="aim-btn">自瞄: 关</button>
          <button id="aim-move-toggle" class="aim-btn">动态: 关</button>
        </div>
      </div>
      <div class="aim-ui aim-ui-bottom">
        <div class="aim-panel" id="aim-panel-auto">
          <div class="aim-pid-row"><label>PID-Kp <output id="val-kp">0.15</output></label><input type="range" id="pid-kp" min="0.01" max="2.0" step="0.01" value="0.15"></div>
          <div class="aim-pid-row"><label>PID-Ki <output id="val-ki">0.005</output></label><input type="range" id="pid-ki" min="0" max="0.2" step="0.001" value="0.005"></div>
          <div class="aim-pid-row"><label>PID-Kd <output id="val-kd">0.10</output></label><input type="range" id="pid-kd" min="0" max="1.0" step="0.01" value="0.10"></div>
          <div class="aim-pid-row"><label>EKF-Q <output id="val-q">0.08</output></label><input type="range" id="kf-q" min="0.001" max="2.0" step="0.001" value="0.08"></div>
          <div class="aim-pid-row"><label>EKF-R <output id="val-r">0.24</output></label><input type="range" id="kf-r" min="0.01" max="5.0" step="0.01" value="0.24"></div>
        </div>
        <div class="aim-panel" id="aim-panel-mouse" style="display:none">
          <div class="aim-pid-row"><label>灵敏度 <output id="val-sens">0.5</output></label><input type="range" id="mouse-sens" min="0.1" max="2" step="0.1" value="0.5"></div>
        </div>
        <div class="aim-settings-row">
          <button id="aim-settings-mouse" class="aim-icon-btn" title="鼠标灵敏度">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3l7.07 16.97 2.51-7.39 7.39-2.51L3 3z"/><path d="M13 13l6 6"/></svg>
          </button>
          <button id="aim-settings-auto" class="aim-icon-btn active" title="自瞄参数">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/><line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="22"/><line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/></svg>
          </button>
        </div>
      </div>
      <div class="aim-ui aim-ui-top-left">
        <span class="aim-fps" id="aim-fps">FPS: --</span>
      </div>
      <div class="aim-ui aim-ui-bottom-left">
        <button class="aim-reset-btn" id="aim-reset" title="重置 (R)">R</button>
      </div>
    </div>

    <!-- ====== Row 3: Statistic & Map/Info ====== -->
    <div class="author-content">
      <div class="about-statistic author-content-item" style="background:url(https://bu.dusays.com/2023/05/01/644f4b037b930.jpg) top/cover no-repeat">
        <div class="card-content">
          <div class="author-content-item-tips">数据</div>
          <span class="author-content-item-title">访问统计</span>
          <div id="statistic">
            <div><span>今日人数</span><span id="today_uv">--</span></div>
            <div><span>今日访问</span><span id="today_pv">--</span></div>
            <div><span>昨日人数</span><span id="yesterday_uv">--</span></div>
            <div><span>昨日访问</span><span id="yesterday_pv">--</span></div>
            <div><span>本月访问</span><span id="last_month_pv">--</span></div>
            <div><span>本年访问</span><span id="last_year_pv">--</span></div>
          </div>
          <div class="post-tips">统计信息来自 <a href="https://umami.gbfun.cc/" target="_blank" rel="noopener nofollow">Umami统计</a></div>
          <div class="banner-button-group">
            <a class="banner-button" href="https://acmex-cosmos.github.io/archives" target="_blank" rel="noopener nofollow">
              <i class="anzhiyufont anzhiyu-icon-arrow-circle-right"></i>
              <span class="banner-button-text">文章隧道</span>
            </a>
          </div>
        </div>
      </div>
      <div class="author-content-item-group column mapAndInfo">
        <div class="author-content-item map single" id="about-map">
          <span class="map-title">我在<b>中国，深圳市南山区，科技园</b></span>
        </div>
        <div class="author-content-item selfInfo single">
          <div>
            <span class="selfInfo-title">深圳职业技术大学</span>
            <span class="selfInfo-content" style="color:#c69043">人工智能技术应用</span>
          </div>
          <div>
            <span class="selfInfo-title">职业</span>
            <span class="selfInfo-content" style="color:#b04fe6">机器人视觉算法</span>
          </div>
        </div>
      </div>
    </div>

    <!-- ====== Row 4: Personality & Photo ====== -->
    <div class="author-content">
      <div class="author-content-item personalities">
        <div class="author-content-item-tips">性格</div>
        <span class="author-content-item-title">逻辑学家</span>
        <div class="title2" style="color:#8b5cf6">INTP</div>
        <div class="image">
          <img src="https://aka.doubaocdn.com/s/RHoOiQDcP8" alt="INTP" />
        </div>
        <div class="post-tips">
          在 <a href="https://www.16personalities.com/" target="_blank" rel="noopener nofollow">16personalities</a> 了解更多关于
          <a href="https://www.16personalities.com/ch/intp-%E4%BA%BA%E6%A0%BC" target="_blank" rel="noopener nofollow">逻辑学家</a>
        </div>
      </div>
      <div class="author-content-item mbti">
        <img src="/blog/INTP-b.svg" alt="INTP" />
      </div>
    </div>

    <!-- ====== Row 5: Maxim & Buff ====== -->
    <div class="author-content">
      <div class="author-content-item maxim" style="background: linear-gradient(120deg, #5b27ff 0, #00d4ff 100%); color: var(--about-white);">
        <div class="author-content-item-tips">座右铭</div>
        <div class="maxim-title">
          <span>减少犯错的方式，</span>
          <span>是建立系统并遵守纪律。</span>
        </div>
      </div>
      <div class="author-content-item buff">
        <div class="card-content"></div>
        <div class="author-content-item-tips">特长</div>
        <span class="buff-title">
          <span style="opacity:.6;margin-bottom:8px">机器人 脑洞大开 小天才</span>
          <span>探索不止 死磕不休 从0到1的践行者</span>
        </span>
        <div class="card-background-icon"><i class="anzhiyufont anzhiyu-icon-dice-d20"></i></div>
      </div>
    </div>

    <!-- ====== Row 6: Hobbies ====== -->
    <div class="author-content">
      <!-- Game card: skew layout like comic -->
      <div class="author-content-item comic-content game-dual">
        <div class="card-content">
          <div class="author-content-item-tips">爱好游戏</div>
          <span class="author-content-item-title">脑洞创造 战术竞技</span>
          <div class="comic-box">
            <div class="comic-item" style="background: url(/blog/images/Minecraft.jpg) center/cover no-repeat;" title="我的世界">
              <span class="game-dual-label">我的世界</span>
            </div>
            <div class="comic-item" style="background: url(/blog/images/CSGO.jpg) center/cover no-repeat;" title="CS:GO">
              <span class="game-dual-label">CS:GO</span>
            </div>
            <div class="comic-item" style="background: url(/blog/images/Valorant.jpg) center/cover no-repeat;" title="Valorant">
              <span class="game-dual-label">Valorant</span>
            </div>
          </div>
        </div>
      </div>
      <!-- Movie/Fanju card -->
      <div class="author-content-item comic-content">
        <div class="card-content">
          <div class="author-content-item-tips">爱好电影</div>
          <span class="author-content-item-title">看剧</span>
          <div class="comic-box">
            <a class="comic-item" href="https://movie.douban.com/subject/26683290/" target="_blank" rel="noopener nofollow" title="你的名字">
              <div class="comic-item-cover"><img src="https://img.gbfun.cc/file/project/Sla6QkMi.webp" alt="你的名字" loading="lazy" /></div>
            </a>
            <a class="comic-item" href="https://movie.douban.com/subject/35267208/" target="_blank" rel="noopener nofollow" title="流浪地球2">
              <div class="comic-item-cover"><img src="https://img.gbfun.cc/file/project/8EPGkTMq.jpg" alt="流浪地球2" loading="lazy" /></div>
            </a>
            <a class="comic-item" href="https://movie.douban.com/subject/36171155/" target="_blank" rel="noopener nofollow" title="胆大党">
              <div class="comic-item-cover"><img src="https://img.gbfun.cc/file/project/6VV5wgFf.webp" alt="胆大党" loading="lazy" /></div>
            </a>
            <a class="comic-item" href="https://movie.douban.com/subject/30402296/" target="_blank" rel="noopener nofollow" title="天气之子">
              <div class="comic-item-cover"><img src="https://img.gbfun.cc/file/project/3rGQM7Dd.webp" alt="天气之子" loading="lazy" /></div>
            </a>
            <a class="comic-item" href="https://www.bilibili.com/bangumi/media/md21231256" target="_blank" rel="noopener nofollow" title="怪兽八号">
              <div class="comic-item-cover"><img src="https://img.gbfun.cc/file/project/5hlDzEtF.webp" alt="怪兽八号" loading="lazy" /></div>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- ====== Row 7: Interests ====== -->
    <div class="author-content">
      {interestItems.map((item) => (
        <div class="author-content-item like-technology" style="background: var(--about-card-bg);">
          <div class="card-content">
            <div class="author-content-item-tips">{item.label}</div>
            <span class="author-content-item-title">{item.desc}</span>
            <div class="content-bottom">
              <span class="interest-icon">{item.icon}</span>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- ====== Row 8: Ten Year Pledge ====== -->
    <div class="author-content">
      <div class="author-content-item card-countdown single" style="background: linear-gradient(120deg, #5b27ff 0, #00d4ff 100%); background-size: 200%; color: var(--about-white);">
        <div class="card-content">
          <div class="author-content-item-tips">十年之约</div>
          <span class="author-content-item-title">寻找更合适的自己。</span>
          <div class="cd-count-left">
            <span class="cd-count-num">{daysLeft}</span>
            <span class="cd-count-text">DAYS</span>
          </div>
          <div class="post-tips">
            <span>{tenYearStart}</span> ~ <span>{tenYearEnd}</span>
          </div>
          <div class="banner-button-group">
            <a class="banner-button" href="https://www.foreverblog.cn/" target="_blank" rel="noopener">
              <i class="anzhiyufont anzhiyu-icon-arrow-circle-right"></i>
              <span class="banner-button-text">十年之约</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- ====== Row 9: Awards ====== -->
    <div class="author-content">
      <div class="author-content-item single reward" style="background: var(--about-card-bg);">
        <div class="author-content-item-tips">竞赛获奖</div>
        <span class="author-content-item-title">赛场荣誉</span>
        <div class="reward-list">
          {awards.map((award) => (
            <div class="reward-list-item">
              <span class="reward-dot"></span>
              <span>{award}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- ====== Row 10: Projects ====== -->
    <div class="author-content">
      <div class="author-content-item single reward" style="background: var(--about-card-bg);">
        <div class="author-content-item-tips">项目经历</div>
        <span class="author-content-item-title">工程实践</span>
        <div class="reward-list">
          {projects.map((project) => (
            <div class="reward-list-item project-item">
              <div class="project-header">
                <strong>{project.title}</strong>
                <span class="project-period">{project.period}</span>
              </div>
              <div class="project-role">{project.role}</div>
              <div class="project-desc">{project.description}</div>
              <div class="project-tags">
                {project.tags.map((tag) => (
                  <span class="project-tag">{tag}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- ====== Footer ====== -->
    <div class="about-footer-wrap">
      <p>持续探索视觉感知、机器人系统与具身智能的边界。</p>
      <span>ACMEX · 2026</span>
    </div>
  </article>
  <style is:inline>
    #web_bg_about {
      position: fixed;
      z-index: 0;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: transparent;
      background-image: url(/blog/img-bg-day.svg);
      background-position: 0 0;
      background-size: 20rem;
      background-repeat: repeat;
      pointer-events: none;
    }
    html.dark #web_bg_about {
      background-size: 100rem;
      opacity: 0.15;
    }
  </style>
</SiteLayout>

<style>
  /* ========== CSS Variables ========== */
  #about-page {
    --about-white: #fff;
    --about-card-bg: hsl(var(--card));
    --about-tag-bg: hsl(var(--muted));
    position: relative;
    z-index: 1;
    --about-accent-1: #5b27ff;
    --about-accent-2: #00d4ff;
    --about-accent-3: #ff27e8;
    --about-accent-4: #ff8000;
    --about-border: 1px solid hsl(var(--border));
    --about-shadow: 0 8px 32px hsl(var(--foreground) / 0.06);
    --about-radius: 24px;
    padding-bottom: 5rem;
    font-family: "Inter", "Noto Sans SC", "PingFang SC", "Microsoft YaHei", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    line-height: 1.6;
  }

  /* ========== Author Box ========== */
  .author-box {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 0 2rem 0;
  }

  .author-tag-left {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .author-tag-right {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .author-tag-left .author-tag:first-child,
  .author-tag-left .author-tag:last-child {
    margin-right: -16px;
  }

  .author-tag-right .author-tag:first-child,
  .author-tag-right .author-tag:last-child {
    margin-left: -16px;
  }

  .author-tag {
    transform: translate(0, -4px);
    padding: 1px 10px;
    background: var(--about-card-bg);
    border: var(--about-border);
    border-radius: 40px;
    margin-top: 6px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.15em;
    box-shadow: var(--about-shadow);
    animation: floating 6s ease-in-out 0s infinite normal none running;
  }

  .author-tag:nth-child(1) { animation-delay: 0s; }
  .author-tag:nth-child(2) { animation-delay: 0.6s; }
  .author-tag:nth-child(3) { animation-delay: 1.2s; }
  .author-tag:nth-child(4) { animation-delay: 1.8s; }

  .author-img {
    margin: 0 30px;
    border-radius: 50%;
    width: 210px;
    height: 210px;
    position: relative;
    user-select: none;
    animation: avatar-breathe 5s ease-in-out infinite;
    transition: transform 0.3s ease, filter 0.3s ease, box-shadow 0.3s ease;
    cursor: pointer;
  }

  .author-img:hover {
    animation-play-state: paused;
    transform: scale(1.12);
    filter: brightness(1.1);
    box-shadow: 0 0 30px hsl(var(--foreground) / 0.15), 0 0 60px hsl(var(--foreground) / 0.06);
  }

  .author-img::after {
    content: '';
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    background: conic-gradient(from 0deg, hsl(var(--foreground) / 0.12) 0deg, transparent 60deg, hsl(var(--foreground) / 0.12) 120deg, transparent 180deg, hsl(var(--foreground) / 0.12) 240deg, transparent 300deg, hsl(var(--foreground) / 0.12) 360deg);
    mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 2px));
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 2px));
    animation: arc-rotate 15s linear infinite;
  }

  .author-img img {
    border-radius: 50%;
    overflow: hidden;
    width: 90%;
    height: 90%;
    object-fit: cover;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .author-img:hover {
    animation-play-state: paused;
  }

  .author-img:hover::after {
    animation-play-state: paused;
  }

  .author-img:before {
    content: '';
    transition: 1s;
    width: 30px;
    height: 30px;
    background: #5cb85c;
    position: absolute;
    border-radius: 50%;
    border: 5px solid hsl(var(--background));
    bottom: 5px;
    right: 10px;
    z-index: 2;
  }

  /* ========== Center Title ========== */
  .p.center {
    text-align: center;
    margin: 0;
  }

  .p.center.logo.large {
    font-size: 2.3rem;
    font-weight: 800;
    letter-spacing: 0.01em;
    margin-bottom: 0.15rem;
    height: 50px;
  }

  .p.center.small {
    font-size: 0.95rem;
    font-weight: 700;
    color: hsl(var(--foreground) / 0.85);
    margin-bottom: 2.5rem;
    letter-spacing: 0.16em;
    text-shadow: 0 0 20px hsl(var(--foreground) / 0.28), 0 0 40px hsl(var(--foreground) / 0.12);
  }

  /* ========== Author Content Grid ========== */
  .author-content {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    width: 100%;
    margin-top: 1.5rem;
    gap: 1.5rem;
  }

  .author-content-item {
    width: 49%;
    border-radius: var(--about-radius);
    background: var(--about-card-bg);
    border: var(--about-border);
    box-shadow: var(--about-shadow);
    position: relative;
    padding: 1.8rem 2.5rem;
    overflow: hidden;
  }

  .author-content-item.single {
    width: 100%;
  }

  .author-content-item .card-content {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    padding: 1rem 2rem;
  }

  .author-content-item .card-content .author-content-item-title {
    margin-bottom: 0.1rem;
  }

  .author-content-item .author-content-item-title {
    font-size: 28px;
    font-weight: 700;
    font-family: "Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif;
    line-height: 1;
  }

  .author-content-item .author-content-item-tips {
    opacity: 0.8;
    font-size: 12px;
    margin-bottom: 0.1rem;
  }

  /* ========== myInfoAndSayHello ========== */
  #about-page .myInfoAndSayHello {
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: var(--about-white);
    background: linear-gradient(120deg, #5b27ff 0, #00d4ff 100%);
    background-size: 200%;
    animation: gradient 15s ease infinite;
    width: 59%;
    border-radius: var(--about-radius);
    box-shadow: 0 4px 12px rgba(46, 127, 255, 0.2);
    transition: all 0.4s cubic-bezier(.25,.46,.45,.94);
  }

  #about-page .myInfoAndSayHello:hover {
    transform: translateY(-6px) scale(1.02);
    box-shadow: 0 12px 32px rgba(46, 127, 255, 0.4), 0 0 0 1px rgba(46, 127, 255, 0.3);
  }

  #about-page .myInfoAndSayHello .title1 {
    opacity: 0.8;
    line-height: 1.3;
  }

  #about-page .myInfoAndSayHello .title2 {
    font-size: 36px;
    font-weight: 700;
    line-height: 1.1;
    margin: 0.5rem 0;
  }

  #about-page .myInfoAndSayHello .inline-word {
    color: var(--about-white);
  }

  /* ========== aboutsiteTips (Pursuit) ========== */
  .author-content-item.aboutsiteTips {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    flex-direction: column;
    width: 39%;
    background: var(--about-card-bg) !important;
  }

  .author-content-item.aboutsiteTips h2 {
    font-size: 36px;
    font-weight: 700;
    line-height: 1.1;
    margin: 0.5rem 0 0;
  }

  .author-content-item.aboutsiteTips .mask {
    display: inline-flex;
    flex-direction: column;
    height: 40px;
    overflow: hidden;
    vertical-align: bottom;
    margin-left: 4px;
  }

  .author-content-item.aboutsiteTips .mask span {
    height: 40px;
    line-height: 40px;
    animation: pursuit-roll 6s ease-in-out infinite;
    background-size: 100% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    background-repeat: no-repeat;
  }

  .author-content-item.aboutsiteTips .mask span:nth-child(1) {
    animation-delay: 0s;
    background-image: linear-gradient(45deg, #0ecffe 50%, #07a6f1);
  }
  .author-content-item.aboutsiteTips .mask span:nth-child(2) {
    animation-delay: 1.2s;
    background-image: linear-gradient(45deg, #18e198 50%, #0ec15d);
  }
  .author-content-item.aboutsiteTips .mask span:nth-child(3) {
    animation-delay: 2.4s;
    background-image: linear-gradient(45deg, #8a7cfb 50%, #633e9c);
  }
  .author-content-item.aboutsiteTips .mask span:nth-child(4) {
    animation-delay: 3.6s;
    background-image: linear-gradient(45deg, #fa7671 50%, #f45f7f);
  }
  .author-content-item.aboutsiteTips .mask span:nth-child(5) {
    animation-delay: 4.8s;
    background-image: linear-gradient(45deg, #f9a825 50%, #f57f17);
  }

  /* ========== Aim Game ========== */
  .aim-game {
    margin: 2rem auto;
    border-radius: var(--about-radius);
    background: var(--about-card-bg);
    border: var(--about-border);
    box-shadow: var(--about-shadow);
    position: relative;
    overflow: hidden;
    user-select: none;
    height: 340px;
    cursor: crosshair;
  }

  .aim-game canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .aim-ui {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    z-index: 10;
    pointer-events: none;
  }

  .aim-ui-top {
    top: 12px;
    right: 16px;
  }

  .aim-ui-bottom {
    bottom: 12px;
    right: 16px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
  }

  .aim-settings-row {
    display: flex;
    gap: 4px;
    pointer-events: auto;
  }

  .aim-ui-top-left {
    top: 12px;
    left: 16px;
  }

  .aim-fps {
    font-size: 12px;
    font-weight: 600;
    color: hsl(var(--foreground) / 0.5);
    background: hsl(var(--card) / 0.8);
    backdrop-filter: blur(8px);
    padding: 3px 8px;
    border-radius: 6px;
    border: 1px solid hsl(var(--border));
    pointer-events: auto;
  }

  .aim-ui-bottom-left {
    bottom: 12px;
    left: 16px;
  }

  .aim-reset-btn {
    width: 24px;
    height: 24px;
    font-size: 11px;
    font-weight: 700;
    color: hsl(var(--foreground) / 0.8);
    background: hsl(var(--card) / 0.6);
    backdrop-filter: blur(8px);
    border: 1px solid hsl(var(--border));
    border-radius: 50%;
    cursor: pointer;
    pointer-events: auto;
    transition: all 0.15s;
    box-shadow: 0 0 6px hsl(var(--foreground) / 0.15);
  }
  .aim-reset-btn:hover {
    color: hsl(var(--primary-foreground));
    background: hsl(var(--primary));
    border-color: hsl(var(--primary));
    box-shadow: 0 0 10px hsl(var(--foreground) / 0.3);
  }

  .aim-stats {
    display: flex;
    gap: 16px;
    font-size: 14px;
    font-weight: 600;
    color: hsl(var(--foreground));
    background: hsl(var(--card) / 0.85);
    backdrop-filter: blur(6px);
    padding: 6px 14px;
    border-radius: 10px;
    border: 1px solid hsl(var(--border));
    pointer-events: none;
  }

  .aim-stats strong {
    color: #ef4444;
    font-size: 16px;
  }

  .aim-controls {
    display: flex;
    gap: 6px;
    pointer-events: auto;
  }

  .aim-btn {
    font-size: 12px;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: 8px;
    border: 1px solid hsl(var(--border));
    background: hsl(var(--card) / 0.85);
    backdrop-filter: blur(6px);
    color: hsl(var(--foreground));
    cursor: pointer;
    transition: all 0.2s;
  }

  .aim-btn:hover {
    background: hsl(var(--muted));
    border-color: hsl(var(--foreground) / 0.3);
  }

  .aim-btn.active {
    background: #ef4444;
    color: #fff;
    border-color: #ef4444;
  }

  .aim-panel {
    display: flex;
    flex-direction: column;
    gap: 2px;
    width: 200px;
    background: hsl(var(--card) / 0.9);
    backdrop-filter: blur(8px);
    padding: 8px 10px;
    border-radius: 10px 10px 0 0;
    border: 1px solid hsl(var(--border));
    border-bottom: none;
    pointer-events: auto;
  }

  .aim-icon-btn {
    width: 30px;
    height: 30px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid hsl(var(--border));
    background: hsl(var(--card) / 0.8);
    color: hsl(var(--foreground) / 0.5);
    cursor: pointer;
    border-radius: 8px;
    transition: all 0.15s;
    padding: 0;
    pointer-events: auto;
  }

  .aim-icon-btn:hover {
    background: hsl(var(--muted));
    color: hsl(var(--foreground) / 0.8);
  }

  .aim-icon-btn.active {
    background: hsl(var(--card) / 0.95);
    color: hsl(var(--foreground));
    border-color: hsl(var(--border));
    box-shadow: 0 0 6px rgba(239, 68, 68, 0.3);
  }

  .aim-pid-row {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 11px;
    font-weight: 600;
    color: hsl(var(--foreground) / 0.7);
  }

  .aim-pid-row label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
    font-weight: 600;
    color: hsl(var(--foreground) / 0.7);
    cursor: default;
  }

  .aim-pid-row output {
    font-size: 11px;
    font-weight: 700;
    color: #ef4444;
    font-variant-numeric: tabular-nums;
    min-width: 44px;
    text-align: right;
  }

  .aim-pid-row input[type="range"] {
    width: 100%;
    height: 4px;
    -webkit-appearance: none;
    appearance: none;
    background: hsl(var(--border));
    border-radius: 2px;
    outline: none;
    cursor: pointer;
  }

  .aim-pid-row input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #ef4444;
    cursor: pointer;
  }

  .aim-pid-row input[type="range"]::-moz-range-thumb {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #ef4444;
    border: none;
    cursor: pointer;
  }

  /* ========== Skills ========== */
  .author-content-item.skills {
    width: 59%;
    min-height: 400px;
  }

  .author-content-item.skills .skills-style-group {
    position: relative;
  }

  .skills:hover .skills-style-group #skills-tags-group-all {
    opacity: 0;
  }

  #skills-tags-group-all {
    display: flex;
    transform: rotate(0);
    transition: 0.3s;
  }

  #skills-tags-group-all .tags-group-wrapper {
    margin-top: 40px;
    display: flex;
    flex-wrap: nowrap;
    animation: rowup 60s linear infinite;
  }

  #skills-tags-group-all .tags-group-icon-pair {
    margin-left: 1rem;
  }

  #skills-tags-group-all .tags-group-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 66px;
    font-weight: 700;
    box-shadow: 0 8px 16px -4px #2c2d300c;
    width: 120px;
    height: 120px;
    border-radius: 30px;
  }

  .skill-icon-text {
    font-size: 16px;
    font-weight: 700;
    color: hsl(var(--foreground));
  }

  #skills-tags-group-all .tags-group-icon-pair .tags-group-icon:nth-child(even) {
    margin-top: 1rem;
    transform: translate(-60px);
  }

  .skills-list {
    position: absolute;
    top: 30px;
    left: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    flex-wrap: wrap;
    opacity: 0;
    transition: opacity 0.3s;
    padding: 0 1rem;
    gap: 0.4rem;
  }

  .skills:hover .skills-list {
    opacity: 1;
  }

  .skill-category {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .skill-category-header {
    font-size: 11px;
    font-weight: 700;
    color: hsl(var(--muted-foreground));
    text-transform: uppercase;
    letter-spacing: 0.05em;
    white-space: nowrap;
    min-width: 80px;
  }

  .skill-category-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .skill-info {
    display: flex;
    align-items: center;
    background: hsl(var(--background));
    border-radius: 20px;
    padding: 3px 10px;
    border: var(--about-border);
    box-shadow: var(--about-shadow);
    cursor: default;
    transition: background 0.2s, color 0.2s, transform 0.2s;
  }

  .skill-info:hover {
    background: hsl(var(--primary));
    transform: translateY(-2px);
  }

  .skill-info:hover .skill-icon-text-small {
    color: hsl(var(--primary-foreground));
  }

  .skill-icon-text-small {
    font-size: 12px;
    font-weight: 600;
    color: hsl(var(--foreground));
  }

  .skills-list .etc {
    margin-right: 10px;
    margin-top: 10px;
    display: flex;
    align-items: center;
    color: hsl(var(--muted-foreground));
  }

  /* ========== Careers ========== */
  .author-content-item.careers {
    min-height: 400px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position-x: right;
    background-position-y: bottom;
    width: 39%;
  }

  .author-content-item.careers .careers-group {
    display: flex;
    flex-direction: column;
    height: 100%;
    margin-top: 12px;
    margin-bottom: 12px;
  }

  .author-content-item.careers .career-item {
    display: flex;
    justify-content: flex-start;
    align-items: center;
  }

  .author-content-item.careers .career-item .circle {
    width: 16px;
    height: 16px;
    margin-top: 3px;
    margin-right: 8px;
    border-radius: 50%;
  }

  .author-content-item.careers .career-item .name {
    color: hsl(var(--muted-foreground));
  }

  .author-content-item.careers img {
    position: absolute;
    left: 0;
    bottom: 20px;
    width: 100%;
    transition: 0.6s;
    z-index: -1;
  }

  /* ========== Statistic ========== */
  #about-page .about-statistic {
    min-height: 380px;
    width: 39%;
    background-size: cover !important;
    color: var(--about-white);
    overflow: hidden;
  }

  #about-page .about-statistic::after {
    box-shadow: 0 -159px 173px 71px #0c1c2c inset;
    position: absolute;
    content: '';
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
  }

  #statistic {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  #statistic div {
    display: flex;
    flex-direction: column;
  }

  #statistic div span:first-child {
    font-size: 12px;
    opacity: 0.7;
  }

  #statistic div span:last-child {
    font-size: 28px;
    font-weight: 700;
  }

  /* ========== Post Tips ========== */
  .post-tips {
    color: hsl(var(--muted-foreground));
    font-size: 14px;
    position: absolute;
    bottom: 1rem;
    left: 2rem;
  }

  .post-tips a {
    color: hsl(var(--muted-foreground)) !important;
    border: none !important;
  }

  .post-tips a:hover {
    color: hsl(var(--foreground)) !important;
    background: transparent !important;
  }

  /* ========== Banner Button ========== */
  .author-content-item .card-content .banner-button-group {
    position: absolute;
    bottom: 1.5rem;
    right: 2rem;
  }

  .author-content-item .card-content .banner-button-group .banner-button {
    height: 40px;
    border-radius: 20px;
    justify-content: center;
    background: rgba(255,255,255,0.2);
    color: var(--about-white);
    display: inline-flex;
    align-items: center;
    z-index: 1;
    transition: .3s;
    cursor: pointer;
    border-bottom: 0 !important;
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: blur(20px);
    transform: translateZ(0);
    padding: 0 16px;
    text-decoration: none;
  }

  .author-content-item .card-content .banner-button-group .banner-button i {
    margin-right: 0.25rem;
    font-size: 22px;
  }

  .author-content-item .card-content .banner-button-group .banner-button .banner-button-text {
    margin-left: 4px;
  }

  .author-content-item .card-content .banner-button-group .banner-button:hover {
    background: hsl(var(--foreground));
    color: var(--about-white);
    border-radius: 20px !important;
  }

  /* ========== Map & SelfInfo ========== */
  .author-content-item-group.column {
    display: flex;
    flex-direction: column;
    width: 49%;
    justify-content: space-between;
  }

  .author-content-item-group.column.mapAndInfo {
    width: 59%;
  }

  .author-content-item.map {
    min-height: 200px;
    max-height: 400px;
    height: 300px;
    position: relative;
    overflow: hidden;
    margin-bottom: 0.5rem;
    transition: 1s ease-in-out;
    background-size: 100%;
    background-repeat: no-repeat;
    background-position: center;
    background-image: url(/blog/images/map-dark.png);
  }

  :global(html:not(.dark)) .author-content-item.map {
    background-image: url(/blog/images/map.png);
  }

  .author-content-item.map .map-title {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    color: hsl(var(--foreground));
    background: hsl(var(--card) / 0.85);
    padding: 0.5rem 2rem;
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: blur(20px);
    transform: translateZ(0);
    transition: all 1s, color 0s ease-in-out;
    font-size: 20px;
  }

  .author-content-item.map .map-title b {
    color: hsl(var(--foreground));
  }

  .author-content-item.map:hover .map-title {
    bottom: -100%;
  }

  .author-content-item.selfInfo {
    display: flex;
    min-height: 100px;
    max-height: 400px;
    justify-content: space-between;
