---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import PostList from '../components/PostList.astro';
import BlogSidebar from '../components/BlogSidebar.astro';
import { PAGE_SIZE, countByCategory, countTags, sortedPosts } from '../utils/posts';

const all = await getCollection('blog');
const allPosts = sortedPosts(all);
const totalPages = Math.max(1, Math.ceil(allPosts.length / PAGE_SIZE));
const posts = allPosts.slice(0, PAGE_SIZE);
const tagCounts = countTags(all);
const counts = countByCategory(all);
---

<SiteLayout>
  <div id="content-header" class="animate">
    <div class="mb-6 mt-6 sm:mt-10">
      <h1 class="inline-block text-3xl font-medium tracking-tight">All Posts</h1>
    </div>
  </div>

  <div class="grid gap-y-16 sm:grid-cols-[3fr_1fr] sm:gap-x-8">
    <section aria-label="Blog posts list" class="animate" id="content">
      <PostList
        posts={posts}
        totalCount={allPosts.length}
        page={{ current: 1, total: totalPages, size: PAGE_SIZE, baseUrl: '/' }}
      />
    </section>

    <BlogSidebar counts={counts} tagCounts={tagCounts} />
  </div>
</SiteLayout>
