---
import { getCollection } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import PostCard from '../components/PostCard.astro';
import TagFilter from '../components/TagFilter.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const allTags = [...new Set(posts.flatMap(p => p.data.tags || []))].sort();
---

<SiteLayout>
  <section>
    <!-- Category nav header like reference -->
    <div class="mb-6 mt-6 sm:mt-10">
      <h1 class="inline-block text-3xl font-semibold tracking-tight">文章</h1>
      <p class="mt-1 text-sm text-[hsl(var(--muted-foreground))]">
        机器人视觉、ROS2 开发与算法学习 — {posts.length} 篇
      </p>
    </div>

    <TagFilter allTags={allTags} />

    <!-- Post list as cards -->
    <div class="flex flex-col gap-y-2">
      {posts.length === 0 ? (
        <p class="text-[hsl(var(--muted-foreground))] py-12 text-center">暂无文章</p>
      ) : (
        posts.map(post => (
          <PostCard
            href={`/blog/${post.id.replace(/\.md$/, '')}`}
            title={post.data.title}
            date={post.data.date}
            description={post.data.description}
            tags={post.data.tags}
          />
        ))
      )}
    </div>
  </section>
</SiteLayout>
