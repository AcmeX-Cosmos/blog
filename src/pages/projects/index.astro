---
import SiteLayout from '../../layouts/SiteLayout.astro';
import projects from '../../data/projects.json';
---

<SiteLayout>
  <section>
    <div class="mb-10 mt-6 sm:mt-10">
      <h1 class="inline-block text-3xl font-semibold tracking-tight mb-2">项目</h1>
      <p class="mt-1 text-sm text-[hsl(var(--muted-foreground))]">
        机器人视觉与算法工程实践 — {projects.length} 个项目
      </p>
    </div>

    <div class="space-y-4">
      {projects.map(project => (
        <article class="group/card relative rounded-2xl border border-[hsl(var(--border))] bg-[hsl(var(--card))] px-5 py-5 transition-colors hover:bg-[hsl(var(--muted))]">
          {project.detail && (
            <a class="absolute inset-0 z-10 rounded-2xl" href={project.detail} aria-label={`查看 ${project.name} 项目详情`}>
              <span class="sr-only">查看项目详情</span>
            </a>
          )}

          <div class="flex justify-between items-start gap-3 mb-2">
            <h2 class="font-medium text-lg">
              <span class="inline-flex items-center gap-1">
                {project.name}
                {project.detail && (
                  <svg
                    aria-hidden="true"
                    class="size-4 shrink-0 opacity-40 transition-transform group-hover/card:translate-x-0.5 group-hover/card:opacity-100"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                )}
              </span>
            </h2>
            <span class="text-xs text-[hsl(var(--muted-foreground))] font-mono shrink-0">{project.role}</span>
          </div>

          <p class="text-sm text-[hsl(var(--muted-foreground))] mb-4 leading-relaxed">
            {project.description}
          </p>

          {project.highlights && project.highlights.length > 0 && (
            <ul class="mb-4 space-y-1">
              {project.highlights.map(h => (
                <li class="text-sm text-[hsl(var(--muted-foreground))] pl-3 relative before:content-[''] before:absolute before:left-0 before:top-2 before:w-1 before:h-1 before:rounded-full before:bg-[hsl(var(--muted-foreground))]">
                  {h}
                </li>
              ))}
            </ul>
          )}

          <div class="flex flex-wrap gap-2 mb-3">
            {project.tags.map(tag => (
              <span class="rounded-full border border-[hsl(var(--border))] bg-[hsl(var(--muted))] px-3 py-1 text-xs font-medium text-[hsl(var(--muted-foreground))]">
                {tag}
              </span>
            ))}
          </div>

          {(project.results?.length > 0 || project.github) && (
            <div class="pointer-events-none relative z-20 flex items-end justify-between gap-4 flex-wrap pt-3 border-t border-[hsl(var(--border))]">
              <div class="flex gap-6 flex-wrap">
                {project.results?.map(r => (
                  <div class="text-sm">
                    <span class="font-semibold">{r.value}</span>
                    <span class="text-[hsl(var(--muted-foreground))] ml-1 text-xs">{r.label}</span>
                  </div>
                ))}
              </div>

              {project.github && (
                <a
                  class="group/github pointer-events-auto inline-flex shrink-0 items-center gap-2 rounded-md border border-[hsl(var(--border))] bg-[hsl(var(--card))] px-3 py-2 text-xs font-semibold transition-colors hover:bg-[hsl(var(--muted))] hover:text-[hsl(var(--foreground))]"
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  title={`${project.name} on GitHub`}
                  aria-label={`在 GitHub 打开 ${project.name}`}
                >
                  <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5a12 12 0 0 0-3.79 23.39c.6.11.82-.26.82-.58v-2.04c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.74.08-.74 1.2.09 1.83 1.23 1.83 1.23 1.07 1.82 2.8 1.3 3.48.99.11-.77.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.47 11.47 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.62-5.49 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.69.83.57A12 12 0 0 0 12 .5Z" /></svg>
                  GitHub
                  <svg aria-hidden="true" class="size-3.5 opacity-60 transition-transform group-hover/github:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M8 7h9v9" /></svg>
                </a>
              )}
            </div>
          )}
        </article>
      ))}
    </div>
  </section>
</SiteLayout>
