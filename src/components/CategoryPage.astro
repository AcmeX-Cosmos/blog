---
import { getCollection } from 'astro:content';
import CategoryHeader from './CategoryHeader.astro';
import PostList from './PostList.astro';
import BlogSidebar from './BlogSidebar.astro';
import { getCategory } from '../data/categories';
import { PAGE_SIZE, countByCategory, sortedPosts } from '../utils/posts';

interface Props {
  category: string;
  page?: number;
}

const { category, page = 1 } = Astro.props;
const meta = getCategory(category);
if (!meta) throw new Error(`Unknown category: ${category}`);

const all = await getCollection('blog');
const posts = sortedPosts(all).filter((p) => p.data.category === category);

const totalPages = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
const slice = posts.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);

const allTags = [...new Set(all.flatMap((p) => p.data.tags || []))].sort();
const counts = countByCategory(all);
---

<CategoryHeader slug={category} title={meta.title} />

<div class="grid gap-y-16 sm:grid-cols-[3fr_1fr] sm:gap-x-8">
  <section aria-label="Blog posts list" class="animate" id="content">
    <PostList
      posts={slice}
      totalCount={posts.length}
      page={{ current: page, total: totalPages, size: PAGE_SIZE, baseUrl: `/blog/${category}` }}
    />
  </section>

  <BlogSidebar counts={counts} allTags={allTags} activeCategory={category} />
</div>
