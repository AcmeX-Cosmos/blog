---
// Collaborative filtering tag list from all posts
interface Props {
  allTags: string[];
  activeTag?: string;
}

const { allTags, activeTag } = Astro.props;
---

<nav class="flex gap-2 flex-wrap mb-8">
  <a
    href="/blog"
    class={`rounded-full border border-[hsl(var(--border))] px-4 py-1.5 text-xs font-medium transition-all duration-200 hover:border-[hsl(var(--foreground))/20 hover:bg-[hsl(var(--muted))]/80 hover:text-[hsl(var(--foreground))] ${
      !activeTag
        ? 'bg-[hsl(var(--foreground))] text-[hsl(var(--background))] border-[hsl(var(--foreground))]'
        : 'bg-[hsl(var(--muted))] text-[hsl(var(--muted-foreground))]'
    }`}
  >
    All
  </a>
  {allTags.map(tag => (
    <a
      href={`/blog/tag/${encodeURIComponent(tag)}`}
      class={`rounded-full border border-[hsl(var(--border))] px-4 py-1.5 text-xs font-medium transition-all duration-200 hover:border-[hsl(var(--foreground))/20 hover:bg-[hsl(var(--muted))]/80 hover:text-[hsl(var(--foreground))] ${
        activeTag === tag
          ? 'bg-[hsl(var(--foreground))] text-[hsl(var(--background))] border-[hsl(var(--foreground))]'
          : 'bg-[hsl(var(--muted))] text-[hsl(var(--muted-foreground))]'
      }`}
    >
      {tag}
    </a>
  ))}
</nav>
