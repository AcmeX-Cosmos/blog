---
interface Props {
  title: string;
  href: string;
  date?: string;
  tags?: string[];
  description?: string;
}

const { title, href, date, description, tags } = Astro.props;
---

<!-- Card-style post preview like reference site -->
<a
  href={href}
  class="group/card block relative rounded-2xl border border-[hsl(var(--border))] bg-[hsl(var(--card))] px-5 py-2.5 sm:py-5 transition-all duration-200 hover:border-[hsl(var(--foreground))/20 hover:bg-[hsl(var(--muted))] mb-3"
>
  <div class="group/link flex flex-col transition-colors hover:text-[hsl(var(--foreground))]">
    <!-- Title row with arrow -->
    <div class="flex justify-between items-start gap-3">
      <h2 class="font-medium text-base sm:text-lg leading-snug group-hover/link:text-[hsl(var(--foreground))]">
        {title}
      </h2>
      <!-- Animated arrow -->
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
        class="shrink-0 my-1 stroke-[hsl(var(--muted-foreground))] group-hover/link:stroke-[hsl(var(--foreground))] transition-colors">
        <line x1="5" y1="12" x2="19" y2="12" class="translate-x-0 transition-all duration-300 ease-in-out group-hover/link:translate-x-1"/>
        <polyline points="12 5 19 12 12 19" class="transition-all duration-300 ease-in-out group-hover/link:translate-x-1"/>
      </svg>
    </div>

    <!-- Description -->
    {description && (
      <p class="line-clamp-2 pt-1 text-sm text-[hsl(var(--muted-foreground))] sm:me-24">
        {description}
      </p>
    )}

    <!-- Meta row: date + word count -->
    <div class="flex items-center gap-2 pt-2 text-xs text-[hsl(var(--muted-foreground))]">
      {date && (
        <time class="font-mono">
          {new Date(date).toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' })}
        </time>
      )}
      {tags && tags.length > 0 && (
        <span>&middot;</span>
      )}
      {tags && tags.length > 0 && (
        <span>{tags.length} 个标签</span>
      )}
    </div>

    <!-- Tags -->
    {tags && tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mt-3">
        {tags.map(tag => (
          <span class="inline-flex items-center gap-x-2 rounded-full border border-[hsl(var(--border))] bg-[hsl(var(--muted))] px-3 py-1 text-xs font-medium text-[hsl(var(--muted-foreground))] transition-colors hover:border-[hsl(var(--foreground))/20 hover:bg-[hsl(var(--muted))]/80 hover:text-[hsl(var(--foreground))]">
            {tag}
          </span>
        ))}
      </div>
    )}
  </div>
</a>
