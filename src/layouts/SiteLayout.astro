---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';
import 'katex/dist/katex.min.css';

interface Props {
  title?: string;
  description?: string;
  universeOpacity?: number;
  viewportWidth?: number;
}

const {
  title,
  description,
  universeOpacity,
  viewportWidth = 1200,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  universeOpacity={universeOpacity}
  viewportWidth={viewportWidth}
>
  <!-- 主题闪烁抑制 -->
  <script is:inline>
    (function () {
      const theme = localStorage.getItem('theme');
      if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>

  <!-- 所有页面沿用站点原有的居中 75% 内容宽度。 -->
  <div class="mx-auto flex min-h-screen w-[75%] flex-col px-4 sm:px-7 lg:px-10 fixed-viewport-shell">
    <Header />

    <main class="mt-6 grow lg:mt-10">
      <slot />
    </main>

    <Footer />
  </div>

</BaseLayout>

<style>
  /* Keep the fixed desktop canvas aligned with the viewport on touch devices. */
  @media (hover: none) and (pointer: coarse) and (orientation: portrait) {
    :global(.fixed-viewport-shell) {
      width: 100% !important;
      max-width: none !important;
    }

    :global(.fixed-viewport-shell > main) {
      width: 100%;
    }
  }
</style>
