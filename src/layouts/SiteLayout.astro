---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
---

<BaseLayout>
  <!-- Inline theme flash prevention -->
  <script is:inline>
    (function() {
      const theme = localStorage.getItem('theme');
      if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>

  <!-- Wrapper: centered, constrained width like reference -->
  <div class="w-[75%] mx-auto px-4 sm:px-7 lg:px-10">

    <!-- Sticky Header -->
    <header id="site-header" class="sticky top-4 z-30 mb-12 flex items-center justify-between rounded-2xl border border-transparent px-1.5 sm:px-4 py-3 transition-all duration-300 bg-transparent sm:rounded-2xl [&.not-top]:border-[hsl(var(--border))] [&.not-top]:bg-[hsl(var(--background))]/60 [&.not-top]:backdrop-blur-md dark:[&.not-top]:bg-[hsl(var(--muted))]/60 [&.not-top]:px-1.5 [&.not-top]:shadow-[0_0_0_1px_rgba(0,0,0,0.03),0_10px_15px_-3px_rgba(0,0,0,0.03),0_4px_6px_-4px_rgba(0,0,0,0.03)]">
      <a href="/blog" class="text-xl font-semibold hover:opacity-70 transition-opacity shrink-0">
        AcmeX
      </a>

      <nav class="hidden sm:flex items-center gap-6 text-sm font-medium">
        <a href="/blog" class="hover:underline underline-offset-4">文章</a>
        <a href="/blog/projects" class="hover:underline underline-offset-4">项目</a>
        <a href="/blog/about" class="hover:underline underline-offset-4">关于</a>
        <!-- <a href="/blog/rss.xml" class="hover:underline underline-offset-4">RSS</a> -->
      </nav>

      <div class="flex items-center gap-2">
        <!-- Theme toggle -->
        <button id="theme-toggle" class="box-content size-4 rounded-md border border-transparent p-1.5 transition-colors hover:bg-[hsl(var(--muted))]" aria-label="切换主题">
          <span class="block dark:hidden">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          </span>
          <span class="hidden dark:block">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          </span>
        </button>
        <!-- Mobile menu toggle -->
        <button id="menu-toggle" class="box-content size-4 rounded-md border border-transparent p-1.5 transition-colors hover:bg-[hsl(var(--muted))] sm:hidden" aria-label="菜单">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
      </div>
    </header>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden sm:hidden mb-8 -mt-8 rounded-xl border border-[hsl(var(--border))] bg-[hsl(var(--card))] p-4 flex flex-col gap-3 text-sm font-medium">
      <a href="/blog" class="py-1">文章</a>
      <a href="/blog/projects" class="py-1">项目</a>
      <a href="/blog/about" class="py-1">关于</a>
    </div>

    <main class="mt-6 lg:mt-10 pb-20">
      <slot />
    </main>

  </div>

  <!-- Theme toggle script -->
  <script>
    // Scroll-aware header glass effect
    const header = document.getElementById('site-header');
    let ticking = false, lastScroll = 0;
    function updateHeader() {
      const scrolled = window.scrollY > 20;
      header?.classList.toggle('not-top', scrolled);
      ticking = false;
    }
    window.addEventListener('scroll', () => {
      if (!ticking) { requestAnimationFrame(updateHeader); ticking = true; }
    }, { passive: true });

    const btn = document.getElementById('theme-toggle');
    btn?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
    const menuBtn = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    menuBtn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
  </script>
</BaseLayout>
